{
  // FIQSTUDIO Tasks: standalone task manager with its own sign-in (owner via the Hub, staff by user ID + password).
  // Deploy from this folder (Build root directory: /tasks). Cloudflare Access must be OFF for this Worker
  // so staff can reach the sign-in page. Secret to set in the dashboard: TASK_HANDOFF_SECRET (same as the Hub Worker).
  "name": "fiqstudio-task",
  "main": "worker.js",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fiqstudio-pm-db",
      "database_id": "36842472-9cec-43f9-a342-07741cbcd0d8"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "fiqstudio-files"
    }
  ],
  "observability": { "enabled": true }
}
